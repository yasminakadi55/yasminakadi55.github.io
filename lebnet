        "from torchao.quantization import apply_weight_only_int8_hadwad_fake_quant\n",
        "\n",
        "# Re-load the LoRA model after the torchao upgrade to ensure compatibility\n",
        "# (This step is important if the kernel was restarted after torchao upgrade, otherwise it might not be strictly necessary, but it's safe practice)\n",
        "base_model_ao = ViTForImageClassification.from_pretrained(\n",
        "    model_name,\n",
        "    num_labels=10,\n",
        "    ignore_mismatched_sizes=True,\n",
        "    low_cpu_mem_usage=True\n",
        ")\n",
        "\n",
        "model_ao = get_peft_model(base_model_ao, lora_config)\n",
        "model_ao = model_ao.to(device)\n",
        "\n",
        "# Apply torchao weight-only int8 quantization\n",
        "apply_weight_only_int8_hadwad_fake_quant(model_ao)\n",
        "\n",
        "print(\"LoRA model with torchao applied:\")\n",
        "print(model_ao)\n",
        "\n",
        "# 5. Define Optimizer & Loss Function for the torchao model\n",
        "criterion_ao = nn.CrossEntropyLoss()\n",
        "optimizer_ao = torch.optim.AdamW(model_ao.parameters(), lr=3e-4, weight_decay=0.01)\n",
        "\n",
        "# 6. Fine-Tuning Loop (1 Epoch) for the torchao model\n",
        "model_ao.train()\n",
        "for epoch in range(1):\n",
        "    running_loss_ao = 0.0\n",
        "    for step, (images, labels) in enumerate(train_loader):\n",
        "        images, labels = images.to(device), labels.to(device)\n",
        "\n",
        "        optimizer_ao.zero_grad()\n",
        "        outputs_ao = model_ao(images)\n",
        "        loss_ao = criterion_ao(outputs_ao.logits, labels)\n",
        "        loss_ao.backward()\n",
        "        optimizer_ao.step()\n",
        "\n",
        "        running_loss_ao += loss_ao.item()\n",
        "        if (step + 1) % 100 == 0:\n",
        "            print(f\"[TorchAO] Epoch [{epoch+1}], Step [{step+1}/{len(train_loader)}], Loss: {running_loss_ao/100:.4f}\")\n",
        "            running_loss_ao = 0.0\n",
        "\n",
        "# 7. Evaluation Loop for the torchao model\n",
        "model_ao.eval()\n",
        "correct_ao = 0\n",
        "total_ao = 0\n",
        "\n",
        "with torch.no_grad():\n",
        "    for images, labels in test_loader:\n",
        "        images, labels = images.to(device), labels.to(device)\n",
        "        outputs_ao = model_ao(images)\n",
        "        _, predicted_ao = torch.max(outputs_ao.logits, 1)\n",
        "        total_ao += labels.size(0)\n",
        "        correct_ao += (predicted_ao == labels).sum().item()\n",
        "\n",
        "torchao_accuracy = 100 * correct_ao / total_ao\n",
        "print(f\"\\nTorchAO + LoRA Test Accuracy on CIFAR-10: {torchao_accuracy:.2f}%\")"
      ]
